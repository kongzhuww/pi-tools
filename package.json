{
  "name": "pi-smart-quota",
  "version": "1.0.0",
  "description": "Smart adaptive quota monitor for OpenAI Codex and Google Antigravity (AGY) in Pi Coding Agent",
  "author": "kongzhu",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "quota",
    "usage",
    "rate-limit",
    "openai-codex",
    "codex",
    "antigravity",
    "gemini",
    "tui",
    "statusline"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --test tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "dependencies": {
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
