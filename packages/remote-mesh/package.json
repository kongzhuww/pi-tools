{
  "name": "pi-remote-mesh",
  "version": "0.1.2",
  "description": "Multi-device remote SSH execution mesh and on-demand tool exposure for Pi Coding Agent",
  "author": "kongzhu",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "ssh",
    "remote",
    "mesh",
    "multi-device",
    "fleet",
    "sftp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kongzhuww/pi-tools.git",
    "directory": "packages/remote-mesh"
  },
  "homepage": "https://github.com/kongzhuww/pi-remote-mesh#readme",
  "bugs": {
    "url": "https://github.com/kongzhuww/pi-remote-mesh/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^24.10.1",
    "@types/ssh2": "^1.15.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typebox": "^1.0.86",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
